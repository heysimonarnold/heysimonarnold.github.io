---
import SiteLayout from "./SiteLayout.astro";

interface Props {
  title: string;
  type: string;
}

const { title, type } = Astro.props;
---

<SiteLayout title={title} type={type}>
  <slot name="after-pager-header" slot="after-pager-header" />
  <div class="text-content-wrapper">
    <slot />
  </div>
</SiteLayout>
