---
import PageLayout from "@/layouts/PageLayout.astro";
import PageListing from "@/components/PageListing.astro";
import type { PageListingItem } from "@/configs/pageListing";
import { getCollection } from "astro:content";

const collection = await getCollection("explorations");

const items: PageListingItem[] = collection
  .sort((a, b) => a.id.localeCompare(b.id))
  .map(({ data }) => ({ title: data.title, url: data.url }));
---

<PageLayout title="Explorations" type="page">
  <PageListing basePath="/explorations" items={items} />
</PageLayout>
