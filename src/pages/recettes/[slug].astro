---
// src/pages/recettes/[id].astro
import RecipeMetadata from "@/components/RecipeMetadata.astro";
import Wysiwyg from "@/components/Wysiwyg.astro";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { isPublished } from "@/utils/content/is-published";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const collection = await getCollection("recettes", isPublished);

  return collection.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const collection = await getCollection("recettes", isPublished);
const slug = Astro.params.slug;
const entry = collection.find((e) => e.id === slug);

if (!entry) throw new Error(`Recette non-trouvée 🤷‍♂️: ${slug}`);

const { Content } = await render(entry);
const data = entry.data;
---

<ArticleLayout title={data.title} type={data.type}>
  <RecipeMetadata
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    recipeYield={data.recipeYield}
  />
  <Wysiwyg>
    <Content />
  </Wysiwyg>
</ArticleLayout>
