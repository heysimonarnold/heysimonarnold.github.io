---
// src/pages/blogue/[slug].astro
import Wysiwyg from "@/components/Wysiwyg.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const collection = await getCollection("blogue");
  return collection.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const collection = await getCollection("blogue");
const slug = Astro.params.slug;
const entry = collection.find((e) => e.id === slug);

if (!entry) throw new Error(`Billet de blogue non-trouvé 🤷‍♂️: ${slug}`);

const { Content } = await render(entry);

const data = entry.data;
---

<BlogLayout
  title={data.title}
  desc={data.desc}
  type={data.type}
  ogImage={data.ogImage}
  hideHeaderImage={data.hideHeaderImage}
>
  <Wysiwyg>
    <Content />
  </Wysiwyg>
</BlogLayout>
